dist/
**/dist/
build/
**/build/
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
apps/web/next-env.d.ts

# Turborepo / Cache / Temporary Files
.turbo/
**/.turbo/
.cache/
**/.cache/
node_modules/.vite/
node_modules/.cache/

# Environment Variables & Secrets
.env
**/.env
.env*.local
**/.env*.local
.env.development
**/.env.development
.env.test
**/.env.test
.env.production
**/.env.production
!.env.example
!**/.env.example

