# ==========================================
# TruyenKomi Monorepo .gitignore
# ==========================================

# ------------------------------------------
# Node.js & Package Managers
# ------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ------------------------------------------
# .NET / C# Build & Cache Outputs
# ------------------------------------------
**/[Bb]in/
**/[Oo]bj/
**/[Dd]ebug/
**/[Rr]elease/
**/TestResults/
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
TestResults/
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user
*.userprefs
*.pidb
*.booproj
*.svclog
*.PublishWithAspNetCoreTargetManifest.cache
*.nupkg
*.snupkg

# ------------------------------------------
# Next.js / Angular / Frontend Build Outputs
# ------------------------------------------
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/
.angular/
**/.angular/
out-tsc/
**/out-tsc/
.sass-cache/
__screenshots__/

# ------------------------------------------
# TypeScript & Cache
# ------------------------------------------
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts
apps/web/next-env.d.ts
.turbo/
**/.turbo/
.cache/
**/.cache/
node_modules/.vite/
node_modules/.cache/
.eslintcache
.stylelintcache

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
**/.env
.env*.local
**/.env*.local
.env.development
**/.env.development
.env.test
**/.env.test
.env.production
**/.env.production
!.env.example
!**/.env.example

# ------------------------------------------
# Local Data, Docker Volumes & Backups
# ------------------------------------------
data/
postgres_data/
redis_data/
meili_data/
backups/
*.sql
*.sql.gz
*.db
*.db-journal
*.sqlite
*.sqlite-journal
.mangadex-checkpoint.json
*.checkpoint.json

# ------------------------------------------
# Logs & Debugging
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Testing & Code Coverage
# ------------------------------------------
coverage/
**/coverage/
.nyc_output/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------
# IDEs, Editors & Visual Studio
# ------------------------------------------
.vs/
**/.vs/
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sw?
*.swp
*.swo
*~
.history/
**/.history/

# VS Code directory rules
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
