{
  "name": "truyenkomi-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@truyenkomi/api",
    "dev:web": "turbo run dev --filter=@truyenkomi/web",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@truyenkomi/api",
    "build:web": "turbo run build --filter=@truyenkomi/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "npm run db:migrate --workspace=@truyenkomi/database",
    "db:seed": "npm run db:seed --workspace=@truyenkomi/database",
    "backup:r2": "tsx scripts/r2-backup.ts backup",
    "backup:list": "tsx scripts/r2-backup.ts list",
    "backup:restore": "tsx scripts/r2-backup.ts restore",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "turbo": "^2.10.13",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
