# ==========================================
# Database (Docker PostgreSQL - Port 5438)
# ==========================================
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5438/truyenkomi_db?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5438/truyenkomi_db?schema=public"

# ==========================================
# Redis (Docker Redis - Port 6385)
# ==========================================
REDIS_URL="redis://localhost:6385"
UPSTASH_REDIS_URL_TCP="redis://localhost:6385"

# ==========================================
# Meilisearch (Docker - Port 7705)
# ==========================================
MEILISEARCH_HOST="http://localhost:7705"
MEILISEARCH_MASTER_KEY="truyenkomi_meili_master_key_2026"

# (Tùy chọn: Upstash Redis Serverless nếu không dùng Docker)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==========================================
# Cloudflare R2 (Object Storage)
# ==========================================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="truyenkomi-comics"
R2_PUBLIC_DOMAIN="https://cdn.truyenkomi.com"

# ==========================================
# Auth & Security
# ==========================================
NEXTAUTH_SECRET="supersecretjwtkey_truyenkomi_fullstack_2026"
NEXTAUTH_URL="http://localhost:3000"
CRAWLER_SECRET_KEY="truyenkomi_crawler_internal_secret_token"

# ==========================================
# Auth.js v5 (cần dùng song song NEXTAUTH_*)
# ==========================================
AUTH_SECRET="supersecretjwtkey_truyenkomi_fullstack_2026"
AUTH_URL="http://localhost:3000"

# ==========================================
# MangaDex API Proxy (Cloudflare Worker)
# ==========================================
MANGADEX_API_URL="https://mangadex.akzan0311.workers.dev"

