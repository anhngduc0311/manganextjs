# ==========================================
# Database (Neon Serverless PostgreSQL)
# ==========================================
# Pooled connection string (dung cho Prisma queries trong serverless / Next.js)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Direct connection string (khuyen dung khi chay Prisma Migrations: prisma migrate dev)
DIRECT_URL="postgresql://user:password@ep-xxxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

# ==========================================
# Upstash Redis (Serverless Cache & Rate Limit)
# ==========================================
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"
# Redis TCP connection (can cho BullMQ Worker) - lay tai console Upstash -> REST API -> Display TCP Endpoint
UPSTASH_REDIS_URL_TCP="rediss://default:password@xxxx.upstash.io:6379"

# ==========================================
# Cloudflare R2 (Object Storage)
# ==========================================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="truyenkomi-comics"
R2_PUBLIC_DOMAIN="https://cdn.truyenkomi.com"

# ==========================================
# Auth & Security
# ==========================================
NEXTAUTH_SECRET="supersecretjwtkey_truyenkomi_fullstack_2026"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="supersecretjwtkey_truyenkomi_fullstack_2026"
AUTH_URL="http://localhost:3000"
CRAWLER_SECRET_KEY="truyenkomi_crawler_internal_secret_token"
