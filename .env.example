# ==========================================
# Database (Neon Serverless PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Upstash Redis (Serverless Cache & Rate Limit)
# ==========================================
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# ==========================================
# Cloudflare R2 (Object Storage)
# ==========================================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="truyenkomi-comics"
R2_PUBLIC_DOMAIN="https://cdn.truyenkomi.com"

# ==========================================
# Auth & Security
# ==========================================
NEXTAUTH_SECRET="supersecretjwtkey_truyenkomi_fullstack_2026"
NEXTAUTH_URL="http://localhost:3000"
CRAWLER_SECRET_KEY="truyenkomi_crawler_internal_secret_token"
