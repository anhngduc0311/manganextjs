# ==========================================
# Stage 1: Build & Bundle Worker
# ==========================================
FROM node:20-alpine AS builder

RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY workers ./workers

# Bundle worker script with esbuild into single lightweight JS file
RUN npx esbuild workers/index.ts \
  --bundle \
  --platform=node \
  --target=node20 \
  --outfile=dist/worker.js \
  --external:@prisma/client \
  --external:@prisma/adapter-pg \
  --external:pg \
  --external:ioredis \
  --external:bullmq \
  --external:sharp \
  --external:pino \
  --external:dotenv

# ==========================================
# Stage 2: Minimal Production Runtime
# ==========================================
FROM node:20-alpine AS runner

RUN apk add --no-cache libc6-compat openssl vips-dev
WORKDIR /app

# Install minimal required runtime packages for worker
RUN npm init -y && \
    npm install --omit=dev --no-package-lock \
      @prisma/client@6.10.0 \
      @prisma/adapter-pg@6.19.3 \
      pg@8.23.0 \
      ioredis@5.4.2 \
      bullmq@5.34.0 \
      sharp@0.35.4 \
      pino@9.4.0 \
      dotenv@16.4.7 && \
    npm cache clean --force

# Copy generated Prisma engine & client
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/prisma ./prisma

# Copy bundled worker script
COPY --from=builder /app/dist/worker.js ./dist/worker.js

ENV NODE_ENV=production

CMD ["node", "dist/worker.js"]
